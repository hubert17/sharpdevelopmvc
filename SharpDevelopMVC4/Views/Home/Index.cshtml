@{ ViewBag.Title = "Home"; }

<div class="jumbotron">
    <h2>ASP.NET</h2>
    <p class="lead">ASP.NET is a free web framework for building great full stack web apps with HTML, CSS, JavaScript, and C#.</p>
    <p><a href="https://asp.net" class="btn btn-primary btn-lg">Learn more &raquo;</a></p>
</div>

<div class="row">
    <!-- Getting Started -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm rounded-lg">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <h2>Getting started</h2>
                    <p class="text-muted small">
                        Get up and running with this lightweight C# ASP.NET MVC 5 application template.
                        Learn how to initialize configurations, resolve package restore issues, and run locally.
                    </p>
                </div>
                <div class="pt-3">
                    <a class="btn btn-secondary" href="/Home/Help">Learn more &raquo;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Get more libraries -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm rounded-lg">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <h2>Get more libraries</h2>
                    <p class="text-muted small">
                        NuGet is a free Visual Studio extension that makes it easy to add, remove, and update libraries and tools in Visual Studio projects.
                    </p>
                </div>
                <div class="pt-3">
                    <a class="btn btn-secondary" href="https://go.microsoft.com/fwlink/?LinkId=301866">Learn more &raquo;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Free Web Hosting -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm rounded-lg">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <h2>Free Web Hosting</h2>
                    <p class="text-muted small">
                        You can easily find a web hosting company that offers the right mix of features and price for your applications.
                    </p>
                </div>
                <div class="pt-3">
                    <a class="btn btn-secondary" href="https://somee.com/FreeAspNetHosting.aspx">Learn more &raquo;</a>
                </div>
            </div>
        </div>
    </div>
</div>
